{
  "name": "logic-pro-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin for Apple Logic Pro — Mackie Control based transport, track strip and navigation with live feedback.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.drewjohnston.logic-pro\""
  },
  "author": "Drew Johnston",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^1.3.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.3.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.16.0",
    "rollup": "^4.22.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  }
}
