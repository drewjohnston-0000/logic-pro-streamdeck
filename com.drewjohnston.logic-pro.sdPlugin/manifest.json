{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Logic Pro",
  "Version": "0.1.0.0",
  "Author": "Drew Johnston",
  "Description": "Control Apple Logic Pro from your Stream Deck: transport, selected-track strip, and marker navigation with live state feedback via Mackie Control.",
  "Category": "Logic Pro",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "UUID": "com.drewjohnston.logic-pro",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Play / Stop",
      "UUID": "com.drewjohnston.logic-pro.transport-play",
      "Icon": "imgs/actions/play/icon",
      "Tooltip": "Toggle playback in Logic Pro.",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/play/key",
          "Name": "Stopped"
        },
        {
          "Image": "imgs/actions/play/key-on",
          "Name": "Playing"
        }
      ]
    }
  ]
}
